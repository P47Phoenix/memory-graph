{
  "note": "Vendored subsets of PUBLIC, permissively licensed (MIT / Apache-2.0) upstream repositories. Each folder under testdata/corpus/ stands for one distinct repo; applications group repos that form a larger system, and links say how the repos connect. Regenerate with scripts/vendor-corpus.py. Never add private code here.",
  "applications": [
    {
      "name": "messaging",
      "description": "The Rebus service bus and two libraries that plug into it (a RabbitMQ transport and a SQL Server transport/storage).",
      "repos": ["rebus", "rebus-rabbitmq", "rebus-sqlserver"]
    },
    {
      "name": "conduit",
      "description": "A Medium-style blogging app (RealWorld/Conduit) as one larger application: an Angular UI, a REST/GraphQL API layer, a MyBatis data-access layer, and the SQL schema scripts.",
      "repos": ["conduit-ui", "conduit-api", "conduit-data-access", "conduit-sql"]
    },
    {
      "name": "rust-library",
      "description": "A stand-alone Rust crate; exercises the Rust extractor (symbols) on real code.",
      "repos": ["anyhow"]
    },
    {
      "name": "webforms",
      "description": "A small ASP.NET Web Forms site (.aspx/.ascx/.asax pages, user controls and code-behind); exercises the ASP.NET markup and C# extractors.",
      "repos": ["webforms"]
    },
    {
      "name": "cobol-web",
      "description": "A tiny COBOL web framework (CGI); exercises the COBOL extractor on real programs.",
      "repos": ["cobol-on-wheelchair"]
    },
    {
      "name": "rpg-json",
      "description": "RPG IV (**FREE) examples for a JSON/XML service program; exercises the RPG extractor.",
      "repos": ["noxdb"]
    },
    {
      "name": "asm-snake",
      "description": "A snake game in 16-bit x86 NASM; exercises the assembly extractor (NASM syntax).",
      "repos": ["snake-asm"]
    },
    {
      "name": "asm-arm64",
      "description": "AArch64 GNU as examples for Apple Silicon; exercises the assembly extractor (GNU as syntax, macros).",
      "repos": ["hellosilicon"]
    }
  ],
