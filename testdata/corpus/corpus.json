    },
    {
      "kind": "implements",
      "from": "conduit-data-access", "from_file": "src/main/java/io/spring/infrastructure/repository/MyBatisArticleRepository.java", "from_contains": "implements ArticleRepository",
      "to": "conduit-api", "to_file": "src/main/java/io/spring/core/article/ArticleRepository.java", "to_contains": "interface ArticleRepository"
    },
    {
      "kind": "table",
      "from": "conduit-data-access", "from_file": "src/main/resources/mapper/ArticleMapper.xml", "from_contains": "insert into articles",
      "to": "conduit-sql", "to_file": "src/main/resources/db/migration/V1__create_tables.sql", "to_contains": "create table articles"
    }
  ]
}
