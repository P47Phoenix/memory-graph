# Auto detect text files and perform LF normalization
* text=auto

# Vendored corpus must stay byte-identical to upstream on every platform.
testdata/corpus/** -text

# Generated gRPC code: the xtask writes LF on every host so that CI's
# `git diff --exit-code` after a regen is about content, never line endings.
crates/graph-proto/src/gen/** text eol=lf

# Extractor test fixtures are asserted byte for byte (spans, text).
crates/graph-lang-*/tests/fixtures/** -text
